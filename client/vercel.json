{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://vivatrack-api.onrender.com/api/:path*" },
    { "source": "/socket.io/", "destination": "https://vivatrack-api.onrender.com/socket.io/" },
    { "source": "/socket.io", "destination": "https://vivatrack-api.onrender.com/socket.io/" },
    { "source": "/socket.io/:path+", "destination": "https://vivatrack-api.onrender.com/socket.io/:path+" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
